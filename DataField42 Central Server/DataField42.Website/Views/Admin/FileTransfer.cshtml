@model FileTransferPageViewModel
<style>
	.ft-steps { display:flex; flex-wrap:wrap; gap:10px; }
	.ft-step { flex:1 1 200px; border:solid 2px var(--c); background:#090b12; padding:8px 10px; color:var(--c); }
	.ft-step-title { font-size:20px; line-height:24px; }
	.ft-step-title span { color:#d4d4d4; font-size:16px; }
	.ft-tiles { display:flex; flex-wrap:wrap; gap:10px; margin:12px 0; }
	.ft-tile { min-width:120px; border:solid 2px #233050; border-top:solid 4px var(--c); background:#090b12; padding:6px 12px; }
	.ft-tile b { display:block; font-size:28px; line-height:32px; font-weight:normal; color:var(--c); }
	.ft-tile.empty { opacity:.55; --c:#233050; }
	.ft-tile.empty b { color:#8a8a8a; }
	.ft-table { width:100%; border-collapse:collapse; table-layout:fixed; }
	.ft-table th { text-align:left; font-weight:normal; color:#6b7a99; font-size:13px; padding:0 8px 4px 8px; border-bottom:solid 1px #233050; }
	.ft-table td { padding:1px 8px; vertical-align:top; overflow-wrap:anywhere; }
	.ft-table tr:hover td { background:#0c1322; }
	.ft-table tr.ft-error td { background:#1a0b10; }
	.ft-table tr.ft-warning td { background:#1a160a; }
	.ft-badge { display:inline-block; width:20px; text-align:center; border:solid 1px var(--c); margin-right:6px; }
	.ft-folder { color:#6b7a99; }
	.ft-name { color:#e6e6e6; }
	.ft-struck { text-decoration:line-through; }
	.ft-dim { color:#8a8a8a; font-size:14px; }
</style>
<div class='container'>
	<div class='titleBox'>File transfer <span class='subTitle'>collection sync</span></div>
</div>
@if (Model.Message is not null)
{
	<div class='container fullW'><div class='textBox' style='color:#57a857;'>@Model.Message</div></div>
}
@if (Model.ErrorMessage is not null)
{
	<div class='container fullW'><div class='textBox' style='color:#ab0909;'>@Model.ErrorMessage</div></div>
}

<div class='container fullW'>
	<div class='textBox'>
		<div style='color:#8a8a8a;margin-bottom:10px;'>Stages 3 to 5 run on the workstation, between steps 1 and 2.</div>
		<div class='ft-steps' data-region="pipeline">
			@for (int i = 0; i < Model.Steps.Count; i++)
			{
				var step = Model.Steps[i];
				<div class='ft-step' style='--c:@(step.Color == TransferDisplay.Grey ? "#233050" : step.Color);'>
					<div class='ft-step-title'>@step.Mark <span>@(i + 1). @step.Title</span></div>
					<div style='font-size:14px;'>@step.Text</div>
				</div>
			}
		</div>
	</div>
</div>

<div class='container fullfW'>
	<div class='titleBox'>Step 1 &mdash; list this server's files</div>
</div>
<div style='clear: both;'></div>
@if (Model.FileListJob is not null)
{
	@await Html.PartialAsync("_JobCard", new JobCardViewModel { Job = Model.FileListJob, ReturnTo = "/Admin/FileTransfer" })
}
<div class='container fullW' data-region="file-list">
	<div class='textBox'>
		@if (Model.ServerFileList is { } fileList)
		{
			<div>@fileList.Name &mdash; @TextFormatting.Size(fileList.Size), written @TextFormatting.Stamp(fileList.ModifiedUtc)</div>
			<br>
			<a href='/Admin/FileTransfer/ServerFileList' class='btn' style='margin-left:0px;'>Download the file list</a>
		}
		else
		{
			<div style='color:#8a8a8a;'>No file list yet.</div>
		}
	</div>
</div>

<div class='container fullfW'>
	<div class='titleBox'>Step 2 &mdash; upload what the workstation made</div>
</div>
<div style='clear: both;'></div>
<div class='container fullW'>
	<div class='textBox'>
		<form method="post" action="/Admin/FileTransfer/Upload" enctype="multipart/form-data">
			@Html.AntiForgeryToken()
			@foreach (var (label, field, accept, file) in new[] { ("Rules (rules.json)", "rules", ".json", Model.Rules), ("New files (newFiles.zip)", "archive", ".zip", Model.Archive) })
			{
				<div style='padding-bottom:10px;'>
					<label style='color:#d4d4d4;'>@label</label><br>
					<input type="file" name="@field" accept="@accept">
					@if (file is not null)
					{
						<span style='color:#8a8a8a;'> uploaded @TextFormatting.Stamp(file.ModifiedUtc), @TextFormatting.Size(file.Size)</span>
					}
				</div>
			}
			<button class='btn' type="submit" style='margin-left:0px;'>Upload</button>
		</form>
	</div>
</div>

<div class='container fullfW'>
	<div class='titleBox'>Step 3 &mdash; review the changes</div>
</div>
<div style='clear: both;'></div>
<div data-region="review">
@if (Model.Preview is { } preview)
{
	@await Html.PartialAsync("_TransferReview", preview)
}
else
{
	<div class='container fullW'><div class='textBox' style='color:#8a8a8a;'>Upload a rules file first.</div></div>
}
</div>

<div class='container fullfW'>
	<div class='titleBox'>Step 4 &mdash; apply</div>
</div>
<div style='clear: both;'></div>
<div data-region="apply">
@if (Model.Preview is { } applyPreview && Model.ApplyJob is not null)
{
	@await Html.PartialAsync("_JobCard", new JobCardViewModel { Job = Model.ApplyJob, ReturnTo = "/Admin/FileTransfer", BlockedReason = applyPreview.BlockedReason })
}
else
{
	<div class='container fullW'><div class='textBox' style='color:#8a8a8a;'>Upload a rules file first.</div></div>
}
</div>
@await Html.PartialAsync("_JobPolling")
